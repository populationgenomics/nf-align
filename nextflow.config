manifest {
    name = 'nf-align'
    description = 'FASTQ / BAM / CRAM -> deduplicated CRAM with bwa-mem3 and dupblaster, driven by Metamist cohorts or sequencing groups'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04'
}

// the defaults. main.nf's params block declares their types
params {
    // what to align: exactly one of cohorts or sgids, from which the run builds its sample sheet in Metamist
    dataset               = null  // the analysis dataset: launches and pays for the run, and holds its run records
    sequencing_type       = null  // genome | exome
    accessLevel           = null  // full | standard, or test: <dataset>-test project and bucket
    arGuid                = null  // supplied from analysis-runner, used in billing labels
    cohorts               = null  // COH1,COH2 on the command line, or a list in a config file
    sgids                 = null  // CPG1,CPG2 on the command line, or a list in a config file. Queried directly, not via cohorts

    // null: each SG's outputs go to its dataset's bucket. Set for local runs: <output_root>/<dataset>/ instead
    output_root           = null

    register              = true  // if false, no metamist registrations
    cram_qc               = true  // if false, no VerifyBamID, samtools stats, Picard metrics or mosdepth, and no cram_qc analysis
    qc_aligned            = false // if true, also QC already-aligned SGs whose CRAM has no cram_qc analysis
    register_wait_minutes = 30    // permitted time (mins) for async output write to destination, prior to registration
    realignment_shards    = 0     // 0: genome 6, exome 1

    // appended verbatim to the dupblaster command line, so quote as for bash, e.g.
    // "--read-name-format 'regex:^(?<su>\\w+:\\d+):(?<tile>\\d+):\\d+:\\d+'"
    dupblaster_extra_args = ''

    // expects <ref_fasta>.{fai,bwt.2bit.64,amb,ann,pac,alt} alongside: the bwa-mem3 index is built once with
    // `bwa-mem3 index <ref_fasta>`, so the FASTA path is also the index prefix. The .alt makes alignment
    // alt-aware, and ref_fasta_dict is the alt-annotated .dict whose @SQ lines bwa-mem3 copies
    ref_fasta             = "gs://cpg-common-main/rd_references/alignment/unmasked/Homo_sapiens_assembly38.fasta"
    ref_fasta_dict        = "gs://cpg-common-main/rd_references/alignment/unmasked/Homo_sapiens_assembly38.dict"

    // the reference an already-aligned CRAM was written against, when its analysis doesn't record one: the
    // DRAGEN-masked FASTA of the CRAMs made before nf-align. The sample sheet builder writes it into such
    // a CRAM's row. Expects <aligned_ref_fasta>.fai alongside
    aligned_ref_fasta     = "gs://cpg-common-main/references/hg38/v0/dragen_reference/Homo_sapiens_assembly38_masked.fasta"

    // bazam, bwa-mem3, dupblaster, samtools, orad
    align_container       = "australia-southeast1-docker.pkg.dev/cpg-common/images/bwa_mem3_ora_dupblaster:v0.15.0-3"

    // metamist and cpg_utils, for the sample sheet and registration
    cpg_container         = "australia-southeast1-docker.pkg.dev/cpg-common/images/nf_base:5.8.1-1"

    // debian container, contains the somalier tool
    somalier_container    = "australia-southeast1-docker.pkg.dev/cpg-common/images-dev/somalier:0.3.6-1"
    // the sites somalier extract fingerprints each CRAM at
    somalier_sites        = "gs://cpg-common-main/references/somalier/sites.hg38.vcf.gz"

    // CRAM QC: images and references as in cpg-flow-align-genotype's config_template.toml
    verifybamid_container = "australia-southeast1-docker.pkg.dev/cpg-common/images/verifybamid:v2.0.3-1"
    picard_container      = "australia-southeast1-docker.pkg.dev/cpg-common/images/picard:3.5.0-3"
    mosdepth_container    = "australia-southeast1-docker.pkg.dev/cpg-common/images/mosdepth:0.3.15-1"

    // VerifyBamID's 1000G contamination resources, per sequencing type
    genome_contam_ud                = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/1000g.phase3.100k.b38.vcf.gz.dat.UD"
    genome_contam_bed               = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/1000g.phase3.100k.b38.vcf.gz.dat.bed"
    genome_contam_mu                = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/1000g.phase3.100k.b38.vcf.gz.dat.mu"
    exome_contam_ud                 = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/whole_exome_illumina_coding_v1.Homo_sapiens_assembly38.1000g.contam.UD"
    exome_contam_bed                = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/whole_exome_illumina_coding_v1.Homo_sapiens_assembly38.1000g.contam.bed"
    exome_contam_mu                 = "gs://cpg-common-main/references/hg38/v0/contamination-resources/1000g/whole_exome_illumina_coding_v1.Homo_sapiens_assembly38.1000g.contam.mu"

    // Regions from Broad's interval lists, stored as BED so they aren't tied to one reference's .dict.
    // PICARD_METRICS turns each into an interval list headed with the CRAM's own .dict (RISKS.md #39)

    // CollectWgsMetrics' regions
    genome_coverage_regions   = "gs://cpg-common-test/rd_references/intervals/wgs_coverage_regions.hg38.bed"
    // CollectHsMetrics' bait and target regions
    exome_evaluation_regions  = "gs://cpg-common-test/rd_references/intervals/exome_evaluation_regions.v1.bed"

    // not read yet: reserved for a future genotyping workflow
    exome_calling_regions     = "gs://cpg-common-test/rd_references/intervals/exome_calling_regions.v1.bed"
    genome_evaluation_regions = "gs://cpg-common-test/rd_references/intervals/wgs_evaluation_regions.hg38.bed"
}

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until we have profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        google.batch.spot = true
        google.batch.maxSpotAttempts = 3
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.accessLevel = 'standard'
        // never pulled: the local executor runs without docker
        params.align_container = 'stub'
        params.cpg_container = 'stub'
        params.somalier_container = 'stub'
        params.verifybamid_container = 'stub'
        params.picard_container = 'stub'
        params.mosdepth_container = 'stub'
        params.register = false
        params.output_root = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
