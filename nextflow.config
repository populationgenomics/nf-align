manifest {
    name = 'nf-align'
    description = 'FASTQ / BAM / CRAM -> deduplicated CRAM with bwa-mem3 and dupblaster, driven by Metamist cohorts or sequencing groups'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10'
}

params {
    // what to align: exactly one of cohorts or sgids (queried in Metamist), or samplesheet (a prepared TSV)
    dataset               = null
    sequencing_type       = null  // genome | exome
    accessLevel           = null  // full | standard, or test: <dataset>-test project and bucket
    arGuid                = null  // supplied from analysis-runner, used in billing labels
    cohorts               = null  // COH1,COH2 on the command line, or a list in a config file
    sgids                 = null  // CPG1,CPG2 on the command line, or a list in a config file. Queried directly, not via cohorts
    samplesheet           = null  // optional secondary input format. Suppresses need to query metamist during startup

    register              = true  // if false, no metamist registrations
    register_wait_minutes = 30    // permitted time (mins) for async output write to destination, prior to registration
    realignment_shards    = 0     // 0: genome 6, exome 1

    // appended verbatim to the dupblaster command line, so quote as for bash, e.g.
    // "--read-name-format 'regex:^(?<su>\\w+:\\d+):(?<tile>\\d+):\\d+:\\d+'"
    dupblaster_extra_args = ''

    // expects <ref_fasta>.{fai,bwt.2bit.64,amb,ann,pac} alongside: the bwa-mem3 index is built once with
    // `bwa-mem3 index <ref_fasta>`, so the FASTA path is also the index prefix
    ref_fasta             = "gs://cpg-common-main/rd_references/alignment/unmasked/Homo_sapiens_assembly38.fasta"
    ref_fasta_dict        = "gs://cpg-common-main/rd_references/alignment/unmasked/Homo_sapiens_assembly38.dict"

    // bazam, bwa-mem3, dupblaster, samtools, orad
    align_container       = "australia-southeast1-docker.pkg.dev/cpg-common/images/bwa_mem3_ora_dupblaster:v0.15.0-3"
    // metamist and cpg_utils, for the sample sheet and registration
    cpg_container         = "australia-southeast1-docker.pkg.dev/cpg-common/images/nf_base:5.8.1-1"
}

// the dataset bucket, so the output block's relative paths match cpg-flow's layout
// unsure if we want to be generating a candiate output directory, or always take it from params/config
outputDir = "gs://cpg-${params.dataset}-${params.accessLevel == 'test' ? 'test' : 'main'}"

workflow.output.mode = 'copy'

// main.nf fails the run before aligning if any output already exists (overwrite = false would skip silently)
workflow.output.overwrite = true

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until we have profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        google.batch.spot = true
        google.batch.maxSpotAttempts = 3
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.accessLevel = 'standard'
        // never pulled: the local executor runs without docker
        params.align_container = 'stub'
        params.cpg_container = 'stub'
        params.register = false
        outputDir = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
