manifest {
    name = 'nf-align'
    description = 'FASTQ / BAM / CRAM -> deduplicated CRAM with bwa-mem3 and dupblaster, driven by Metamist cohorts'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10'
}

params {
    // what to align: exactly one of cohorts (queried in Metamist) or samplesheet (a prepared TSV)
    dataset = null
    sequencing_type = null // genome | exome
    accessLevel = 'standard' // full | standard (equivalent), or test: <dataset>-test project and bucket
    arGuid = null
    cohorts = null // COH1,COH2 on the command line, or a list in a config file
    samplesheet = null

    register = true
    register_wait_minutes = 30
    realignment_shards = 0 // 0: genome 6, exome 1
    // appended verbatim to the dupblaster command line, so quote as for bash, e.g.
    // "--read-name-format 'regex:^(?<su>\\w+:\\d+):(?<tile>\\d+):\\d+:\\d+'"
    dupblaster_extra_args = ''

    ref_fasta = 'gs://cpg-common-main/references/hg38/v0/dragen_reference/Homo_sapiens_assembly38_masked.fasta'
    // <prefix>.{bwt.2bit.64,amb,ann,pac}, built once with `bwa-mem3 index` against ref_fasta
    bwa_index_prefix = null

    align_container = null // bazam, bwa-mem3, dupblaster, samtools, orad
    cpg_container = null // metamist and cpg_utils, for the sample sheet and registration
}

// the dataset bucket, so the output block's relative paths match cpg-flow's layout
outputDir = "gs://cpg-${params.dataset}-${params.accessLevel == 'test' ? 'test' : 'main'}"

workflow.output.mode = 'copy'
// main.nf fails the run before aligning if any output already exists (overwrite = false would skip silently)
workflow.output.overwrite = true

includeConfig 'conf/base.config'

profiles {
    // the launcher supplies -work-dir and google.project
    gcb {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        google.batch.spot = true
        google.batch.maxSpotAttempts = 3
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        params.arGuid = 'local-test'
        params.register = false
        outputDir = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
