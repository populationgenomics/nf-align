// Per-process resources and containers
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = params.align_container
    // the analysis dataset, for BUILD_SAMPLESHEET and WRITE_RUN_RECORDS; per-SG processes override it below
    resourceLabels = [
        'ar-guid': params.arGuid,
        'dataset': params.dataset,
        'compute-category': 'nextflow',
    ]

    // OOM (137/140) retries with more memory; any other failure drops that SG and the run carries on.
    // The dropped SGs aren't reported: Seqera lists the failed tasks, and a -resume picks them up again.
    // Spot preemption is retried separately by google.batch.maxSpotAttempts.
    errorStrategy = { task.exitStatus in [137, 140] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2

    // Every process names one exact machineType, indexed by task.attempt so OOM retries land on a bigger VM.
    // With NXF_CLOUDINFO_ENABLED=false, Nextflow only records a machine type in the trace (and Seqera only
    // estimates cost) for an exact type; a list or wildcard is dropped and Google Batch picks the VM unrecorded.
    // Keep it that way (RISKS.md #32).
    // Each type leaves memory headroom over the request, since a request equal to VM memory may not fit.

    // each SG's compute is billed to its own dataset
    withName: 'SORT_INDEX|ALIGN_TO_CRAM|ALIGN_SHARD|MERGE_TO_CRAM|SOMALIER_EXTRACT|VERIFYBAMID|SAMTOOLS_STATS|PICARD_METRICS|REGISTER_CRAM|REGISTER_CRAM_QC' {
        resourceLabels = { ['ar-guid': params.arGuid, 'dataset': meta.dataset, 'compute-category': 'nextflow'] }
    }

    // Every destination is worked out in main.nf and carried in meta (or passed as run_dir); these only apply it:
    // the CRAM and its companions go to meta.cramDir, and every QC file to meta.qcDir (ADR 0014).
    // overwrite: false leaves an existing target in place silently, so main.nf's pre-flight checks are what
    // catch a clash (ADR 0009)
    withName: 'ALIGN_TO_CRAM|MERGE_TO_CRAM' {
        publishDir = [
            [path: { meta.cramDir }, pattern: '*.cram*', mode: 'copy', overwrite: false],
            [path: { meta.qcDir }, pattern: '*.markduplicates-metrics', mode: 'copy', overwrite: false],
        ]
    }
    withName: 'SOMALIER_EXTRACT' {
        publishDir = [path: { meta.cramDir }, mode: 'copy', overwrite: false]
    }
    withName: 'VERIFYBAMID|SAMTOOLS_STATS|PICARD_METRICS' {
        publishDir = [path: { meta.qcDir }, mode: 'copy', overwrite: false]
    }
    withName: 'BUILD_SAMPLESHEET|WRITE_RUN_RECORDS' {
        publishDir = [path: { run_dir }, mode: 'copy', overwrite: false]
    }

    withName: 'BUILD_SAMPLESHEET' {
        container = params.cpg_container
        cpus = 1
        memory = 4.GB
        machineType = 'e2-standard-2'
        // without a sample sheet there is nothing to do
        errorStrategy = 'terminate'
    }
    // run-level, like BUILD_SAMPLESHEET: a failed pre-flight check must stop the run, and ignoring a failure
    // writing the records would lose them unnoticed
    withName: 'PREFLIGHT|WRITE_RUN_RECORDS' {
        errorStrategy = 'terminate'
    }
    withName: 'REGISTER_CRAM|REGISTER_CRAM_QC' {
        container = params.cpg_container
        cpus = 1
        memory = 2.GB
        machineType = 'e2-standard-2'
        // Metamist hiccups get one more try; after that the SG is dropped
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    }

    // bwa-mem3 holds ~10.5 GB of hg38 index and peaks ~15 GB at 16 threads; bazam's heap is capped at 16 GB.
    // bwa-mem3 needs AVX2, which N1 machines may lack; N2 has it.
    withName: 'ALIGN_TO_CRAM|ALIGN_SHARD' {
        cpus = 16
        memory = { 48.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 400.GB : 100.GB }
        // 64 / 128 / 256 GB
        machineType = { ['n2-standard-16', 'n2-highmem-16', 'n2-highmem-32'][task.attempt - 1] }
    }
    // no aligner here: samtools merge -> dupblaster -> sort -> CRAM
    withName: 'MERGE_TO_CRAM' {
        cpus = 8
        memory = { 24.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 400.GB : 100.GB }
        // 32 / 64 / 128 GB
        machineType = { ['n2-standard-8', 'n2-highmem-8', 'n2-highmem-16'][task.attempt - 1] }
    }
    // somalier reads only the sites from the CRAM, single-threaded; the disk holds the CRAM
    withName: 'SOMALIER_EXTRACT' {
        container = params.somalier_container
        cpus = 1
        memory = { 4.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 100.GB : 20.GB }
        // 8 / 16 / 32 GB
        machineType = { ['e2-standard-2', 'e2-standard-4', 'e2-standard-8'][task.attempt - 1] }
    }
    // CRAM QC (ADR 0014): each task stages the whole CRAM, so its disk is sized as SOMALIER_EXTRACT's
    withName: 'VERIFYBAMID' {
        container = params.verifybamid_container
        cpus = 4
        memory = { 12.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 100.GB : 20.GB }
        // 16 / 32 / 64 GB
        machineType = { ['n2-standard-4', 'n2-highmem-4', 'n2-highmem-8'][task.attempt - 1] }
    }
    // samtools is in the align image
    withName: 'SAMTOOLS_STATS' {
        cpus = 4
        memory = { 4.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 100.GB : 20.GB }
        // 16 / 16 / 32 GB
        machineType = { ['e2-standard-4', 'e2-standard-4', 'e2-standard-8'][task.attempt - 1] }
    }
    // two JVMs side by side, each with a 40% heap
    withName: 'PICARD_METRICS' {
        container = params.picard_container
        cpus = 4
        memory = { 12.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 100.GB : 20.GB }
        // 16 / 32 / 64 GB
        machineType = { ['n2-standard-4', 'n2-highmem-4', 'n2-highmem-8'][task.attempt - 1] }
    }
    withName: 'SORT_INDEX' {
        cpus = 8
        memory = { 32.GB * task.attempt }
        // input + sorted BAM + sort spill
        disk = { params.sequencing_type == 'genome' ? 550.GB : 250.GB }
        // 64 / 128 / 128 GB
        machineType = { ['n2-highmem-8', 'n2-highmem-16', 'n2-highmem-16'][task.attempt - 1] }
    }
}
