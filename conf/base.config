// Per-process resources and containers
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = params.align_container
    resourceLabels = [
        'ar-guid': params.arGuid,
        'dataset': params.dataset,
        'compute-category': 'nextflow',
    ]

    // OOM (137/140) retries with more memory; any other failure drops that SG and the run carries on.
    // main.nf lists the dropped SGs in alignment_samplesheets/<arGuid>/failed.csv. Spot preemption is
    // retried separately by google.batch.maxSpotAttempts.
    errorStrategy = { task.exitStatus in [137, 140] && task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2

    withName: 'BUILD_SAMPLESHEET' {
        container = params.cpg_container
        cpus = 1
        memory = 4.GB
        // without a sample sheet there is nothing to do
        errorStrategy = 'terminate'
    }
    withName: 'REGISTER_ANALYSIS' {
        container = params.cpg_container
        cpus = 1
        memory = 2.GB
        // Metamist hiccups get one more try; after that the SG is reported as failed at 'register'
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    }

    // bwa-mem3 holds ~10.5 GB of hg38 index and peaks ~15 GB at 16 threads; bazam's heap is capped at 16 GB.
    // bwa-mem3 needs AVX2, which N1 machines may lack, so only AVX2 families are allowed.
    withName: 'ALIGN_TO_CRAM|ALIGN_SHARD' {
        cpus = 16
        memory = { 48.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 400.GB : 100.GB }
        machineType = 'n2-*,n2d-*,c2d-*,c3d-*'
    }
    // no aligner here: samtools merge -> dupblaster -> sort -> CRAM
    withName: 'MERGE_TO_CRAM' {
        cpus = 8
        memory = { 24.GB * task.attempt }
        disk = { params.sequencing_type == 'genome' ? 400.GB : 100.GB }
    }
    withName: 'SORT_INDEX' {
        cpus = 8
        memory = { 32.GB * task.attempt }
        // input + sorted BAM + sort spill
        disk = { params.sequencing_type == 'genome' ? 550.GB : 250.GB }
    }
}
